# Local dev uses SQLite; production: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./ficheassur.db
ALLOWED_ORIGINS=http://localhost:3100
# Country the funnel targets: phone parsing region + postal code rules
TARGET_REGION=FR
# Comma-separated IPs refused outright (stand-in for an IP reputation service)
BLOCKED_IPS=
