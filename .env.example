# Local dev uses SQLite; production: postgresql+asyncpg://user:pass@host/db
DATABASE_URL=sqlite+aiosqlite:///./ficheassur.db
ALLOWED_ORIGINS=http://localhost:3100
# Country the funnel targets: phone parsing region + postal code rules
TARGET_REGION=FR
# Comma-separated IPs refused outright (stand-in for an IP reputation service)
BLOCKED_IPS=
# Signs espace pro login tokens: a long random value in production
SECRET_KEY=
# Public site address (activation links, Stripe return URLs)
SITE_URL=http://localhost:3100
# OAuth client ID for "Continuer avec Google" (same value as the site's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID). Blank = Google sign-in off.
GOOGLE_CLIENT_ID=
# Azure app (client) ID for "Continuer avec Microsoft" (same value as the
# site's NEXT_PUBLIC_MICROSOFT_CLIENT_ID). Blank = Microsoft sign-in off.
MICROSOFT_CLIENT_ID=
# Shared secret with New World Courtage (its FICHEASSUR_IMPORT_KEY): lets
# NWC's CRM put leads on sale here. Long random value; blank = imports off.
IMPORT_API_KEY=
# Stripe (card payment at each purchase). Webhook endpoint:
# {API}/api/v1/billing/webhook, events checkout.session.completed,
# checkout.session.expired, checkout.session.async_payment_succeeded,
# checkout.session.async_payment_failed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Local dev only: purchases go through without a card payment. NEVER true in production.
PAYMENTS_SIMULATED=false
